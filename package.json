{
  "name": "@residenthiago/dsh-tool-router",
  "version": "1.2.0",
  "type": "module",
  "description": "Lazy tool discovery: hides every tool schema from prefill and reveals one through a decision-model choice on demand.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/residenthiago2011/DSH-Tool-Router.git"
  },
  "homepage": "https://github.com/residenthiago2011/DSH-Tool-Router#readme",
  "bugs": {
    "url": "https://github.com/residenthiago2011/DSH-Tool-Router/issues"
  },
  "meta": {
    "title": "DSH Tool Router",
    "description": "Zero tool schemas in prefill; discovers one tool per turn through a decision model API endpoint."
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "README.md",
    "cordis.patch.yml",
    "tool-registry.json",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
